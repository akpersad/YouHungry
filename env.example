# ============================================
# Application Configuration
# ============================================

# Application URL (used for fork links and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Database Configuration
# ============================================

# MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# MongoDB database name.
# LOCAL DEV: point this at the dev database (you-hungry-v2-dev), never the
# production one — the v2 seed/demo scripts refuse to run against
# "you-hungry". Production (Vercel env) keeps you-hungry.
MONGODB_DATABASE=you-hungry-v2-dev

# HMAC secret for guest cookies + fork tokens (generate per environment,
# e.g. `openssl rand -base64 32`)
V2_TOKEN_SECRET=

# ============================================
# Authentication (Clerk)
# ============================================

# Clerk publishable key (client-side)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk secret key (server-side)
CLERK_SECRET_KEY=sk_test_...

# Clerk webhook secret (for validating webhook signatures)
CLERK_WEBHOOK_SECRET=whsec_...

# ============================================
# Google APIs
# ============================================

# Google Places API key (server-side; the only Google API v2 calls)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Billing gate: outside the production deployment, the Places client
# never calls Google (cache-only) unless this is explicitly set to true.
# ALLOW_GOOGLE_PLACES=true

# ============================================
# Email Service (Resend)
# ============================================

# Resend API key (fork-result emails to account holders)
RESEND_API_KEY=your-resend-api-key

# From email address (for sending notifications)
FROM_EMAIL=noreply@forkintheroad.app

# ============================================
# Notification suppression (dev safety)
# ============================================

# External sends (email, web push) only happen when VERCEL_ENV=production
# or this is explicitly set. Leave unset in dev/CI.
# ALLOW_REAL_NOTIFICATIONS=true

# ============================================
# Admin Configuration
# ============================================

# Admin user IDs (comma-separated MongoDB user _ids) — gates /admin
ADMIN_USER_IDS=your-mongodb-user-id-here

# ============================================
# Push Notifications (VAPID)
# ============================================

# VAPID keys for Web Push Notifications
# Generate new keys using: npx web-push generate-vapid-keys
# Public key is used by the client (browser) to subscribe to push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Private key is used by the server to send push notifications (KEEP SECRET!)
VAPID_PRIVATE_KEY=

# Contact email for VAPID identification (required for push notification service)
VAPID_SUBJECT=mailto:your-email@example.com

# ============================================
# Development & Debugging (Optional)
# ============================================

# Enable console logging in production (default: false)
# ENABLE_CONSOLE_LOGS=true

# Enable bundle analysis (default: false)
# ANALYZE=true
