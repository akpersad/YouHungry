{
  "name": "forkintheroad",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "node scripts/check-server.js 3000 && next dev",
    "dev:https": "next dev --experimental-https --experimental-https-key ./certificates/cert-key.pem --experimental-https-cert ./certificates/cert.pem",
    "dev:force": "next dev",
    "dev:kill": "lsof -ti:3000 | xargs kill -9",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "analyze": "ANALYZE=true npm run build:webpack",
    "type-check": "tsc",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:accessibility": "playwright test --grep axe --project=chromium",
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect",
    "lighthouse:assert": "lhci assert",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "pre-push": "npm run type-check && npm run lint -- --max-warnings=0 && npm run format:check && npm run test && npm run build",
    "prod": "node scripts/run-production.js all",
    "prod:build": "node scripts/run-production.js build",
    "prod:start": "node scripts/run-production.js start",
    "prod:https": "node scripts/run-production.js all https",
    "prod:https:start": "node scripts/run-production.js start https",
    "seed:v2-dev": "tsx scripts/v2/seed-dev.ts",
    "demo:v2-foundations": "tsx scripts/v2/demo-foundations.ts",
    "migrate:v1": "tsx scripts/v2/migrate-v1.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "mongodb": "^7.4.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "svix": "^1.96.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@clerk/backend": "^3.11.0",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
